# Low-cost text model. Keys belong only in the untracked .env file.
AI_PROVIDER=aimlapi
AIML_API_KEY=your_aiml_api_key_here
AIML_MODEL=openai/gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_INPUT_CHARS=24000

# Optional microphone transcription (separate from AI/ML text credits).
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional legacy Groq provider / Whisper transcription fallback.
# Set AI_PROVIDER=groq to route text requests through Groq instead.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional local call database. Default: .delegate-data/calls.sqlite3
# DELEGATE_DATABASE=/path/to/calls.sqlite3

# Agent voice for ordinary replies. Free, no API key, no credits: edge-tts uses
# Microsoft's neural voices.
#
# The app has a Female / Male dropdown (en-US-AvaNeural / en-US-AndrewNeural),
# so you do not need to set anything here. TTS_VOICE only changes the fallback
# default, and is how you use any of the other 320 voices.
#   python preview_voices.py     # hear the shortlist and choose
# Alternatives: en-US-EmmaNeural, en-US-BrianNeural, en-GB-SoniaNeural, en-GB-RyanNeural.
# TTS_VOICE=en-US-AvaNeural

# Live listening (the other side just talks). Uses ASSEMBLYAI_API_KEY above and
# needs NO tunnel. Default model is best for English; switch it if the other
# side speaks another language.
# STREAMING_SPEECH_MODEL=universal-streaming-multilingual

# Live voice calls through the AssemblyAI Voice Agent API (optional).
# AssemblyAI listens and speaks; CallBridge still decides every word and the
# approval gate is unchanged. Billed at $4.50/hour of call time.
#
# AssemblyAI calls this server back, so it needs a public https address.
# For local development, run a tunnel and paste its URL here:
#   cloudflared tunnel --url http://localhost:8000
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
#
# Agent voice. US: alba eve george jane jean mary michael.
# UK: anna charles paul vera. Other languages: giovanni lola juergen rafael estelle.
# VOICE_AGENT_VOICE=michael
#
# Seconds the agent holds the line while you decide. It speaks holding phrases
# rather than going silent, then politely offers to call back.
# VOICE_APPROVAL_TIMEOUT_SECONDS=120
#
# Secret AssemblyAI must present to reach the model endpoint. Generated per
# run when unset; set it to keep agents working across restarts.
# VOICE_BRIDGE_TOKEN=change_me_to_a_long_random_string

# Private pilot sharing. Use a random passcode of at least 16 characters.
# Share it only with trusted workspace hosts, not business participants.
# Public mode requires the passcode and HTTPS (secure session cookies).
# Local-only development works with both settings unset.
# DELEGATE_PUBLIC_MODE=true
# DELEGATE_PILOT_PASSCODE=replace-with-a-long-random-passcode
